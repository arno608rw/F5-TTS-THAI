    {
      "name": "Text to Speech (Direct)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ref_audio_path\": \"./src/f5_tts/infer/examples/thai_examples/ref_gen_1.wav\",\n  \"ref_text\": \"ได้รับข่าวคราวของเราที่จะหาที่มันเป็นไปที่จะจัดขึ้น\",\n  \"gen_text\": \"พรุ่งนี้มีประชุมสำคัญ อย่าลืมเตรียมเอกสารให้เรียบร้อย\",\n  \"remove_silence\": true,\n  \"cross_fade_duration\": 0.15,\n  \"nfe_step\": 32,\n  \"speed\": 1.0,\n  \"cfg_strength\": 2.0,\n  \"max_chars\": 250,\n  \"seed\": -1,\n  \"no_ref_audio\": false,\n  \"return_spectrogram\": false,\n  \"return_format\": \"{{return_format}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "tts"
          ]
        },
        "description": "Generate speech using direct audio file path and reference text"
      },
      "response": []
    },
    {
      "name": "Text to Speech (File Upload)",
      "request": {
