  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default values if not already set in environment",
          "if (!pm.environment.get('base_url')) {",
          "    pm.environment.set('base_url', 'http://localhost:4000');",
          "}",
          "if (!pm.environment.get('whisper_model')) {",
          "    pm.environment.set('whisper_model', 'large-v3-turbo');",
          "}",
          "if (!pm.environment.get('sample_emotion')) {",
          "    pm.environment.set('sample_emotion', 'normal');",
          "}",
          "if (!pm.environment.get('return_format')) {",
          "    pm.environment.set('return_format', 'audio_base64');",
          "}",
          "if (!pm.environment.get('multistyle_mode')) {",
          "    pm.environment.set('multistyle_mode', 'direct');",
          "}",
          "if (!pm.environment.get('sample_multistyle_text')) {",
          "    pm.environment.set('sample_multistyle_text', '{normal} สวัสดีครับ {happy} วันนี้ผมมีความสุขมาก {sad} แต่บางทีก็เศร้า');",
          "}",
          "if (!pm.environment.get('sample_multiline_text')) {",
          "    pm.environment.set('sample_multiline_text', 'สวัสดีครับ\\nวันนี้อากาศดีมาก\\nเหมาะสำหรับไปเดินเล่นที่สวนสาธารณะ');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Basic response validation",
          "pm.test('Status code is 200 or 201', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "// Check if response is JSON (except for file downloads)",
          "pm.test('Response is JSON or file', function () {",
          "    const contentType = pm.response.headers.get('Content-Type');",
          "    pm.expect(contentType).to.satisfy(function(type) {",
          "        return type.includes('application/json') || type.includes('audio/wav');",
          "    });",
          "});",
          "",
          "// Check if JSON response has success field",
          "if (pm.response.headers.get('Content-Type').includes('application/json')) {",
          "    pm.test('Response has success field', function () {",
          "        const jsonData = pm.response.json();",
